# Copy this file to apps/web/.env.local for local runs, or set the same key in
# the Vercel project settings. .env.* is git-ignored; this example is not.

# Cities Paintoor books today, comma-separated. Unset or empty = Mumbai only.
# Adding a city switches on its page, sitemap entry, search hint, post-job
# wizard option, partner filters, hero count and SEO copy all together — no
# component edits, no drift. Seed partners already exist for Mumbai, Vadodara,
# Surat, Ahmedabad, Amritsar, Chennai and Indore; a brand-new city also needs
# its partner rows added to packages/mock-api/src/seeds/providers.json.
NEXT_PUBLIC_LAUNCH_CITIES="Mumbai"
# Paintoor web — environment template. Copy to .env.local and fill.
# .env.local is git-ignored (.env* rule in the root .gitignore). NEVER commit secrets.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler".
# Replace [YOUR-PASSWORD] with the database password you set at project creation
# (same screen has a reset if forgotten). Keep ?pgbouncer=true for the pooler.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Signs our own session JWTs (module 2.2). Generate once, keep forever:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=