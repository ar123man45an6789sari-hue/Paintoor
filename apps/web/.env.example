# Copy this file to apps/web/.env.local for local runs, or set the same key in
# the Vercel project settings. .env.* is git-ignored; this example is not.

# Cities Paintoor books today, comma-separated. Unset or empty = Mumbai only.
# Adding a city switches on its page, sitemap entry, search hint, post-job
# wizard option, partner filters, hero count and SEO copy all together — no
# component edits, no drift. Seed partners already exist for Mumbai, Vadodara,
# Surat, Ahmedabad, Amritsar, Chennai and Indore; a brand-new city also needs
# its partner rows added to packages/mock-api/src/seeds/providers.json.
NEXT_PUBLIC_LAUNCH_CITIES="Mumbai"
